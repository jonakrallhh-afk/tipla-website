---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="TIPLA – Planungssoftware für Tischlereien" noindex>
  <main class="wrap">
    <a href="/" class="marke" aria-label="TIPLA Startseite">
      <Logo variante="hell" groesse={44} />
    </a>
    <h1>Weniger Büro.<br />Mehr Werkstatt.</h1>
    <p class="unterzeile">
      Die Planungssoftware für Tischlereien. Gebaut von einem Tischlermeister in Hamburg.
    </p>
    <p class="hinweis"><span class="punkt" aria-hidden="true"></span>Bald verfügbar</p>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100vh;
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .marke {
    align-self: flex-start;
    text-decoration: none;
    margin-bottom: 3rem;
  }

  h1 {
    font-family: var(--schrift-marke);
    font-weight: 700;
    font-size: clamp(2.6rem, 7.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }

  .unterzeile {
    font-size: 1.2rem;
    color: var(--text-leise);
    margin: 0 0 2.5rem;
    max-width: 32rem;
  }

  .hinweis {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    margin: 0;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: var(--tinte);
    color: var(--papier);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .punkt {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--gelb);
  }
</style>
