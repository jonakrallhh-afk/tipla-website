---
import Base from '../layouts/Base.astro';
---

<Base title="TIPLA – Planungssoftware für Tischlereien" noindex>
  <main class="wrap">
    <p class="marke">TIPLA</p>
    <h1>Weniger Büro.<br />Mehr Werkstatt.</h1>
    <p class="unterzeile">
      Die Planungssoftware für Tischlereien. Gebaut von einem Tischlermeister in Hamburg.
    </p>
    <p class="hinweis">Bald verfügbar.</p>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100vh;
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .marke {
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--akzent);
    margin: 0 0 1.5rem;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.05;
    margin: 0 0 1.25rem;
    color: var(--holz-dunkel);
  }

  .unterzeile {
    font-size: 1.2rem;
    color: var(--text-leise);
    margin: 0 0 2.5rem;
    max-width: 32rem;
  }

  .hinweis {
    display: inline-block;
    align-self: flex-start;
    margin: 0;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--holz-dunkel);
    color: var(--holz-hell);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
