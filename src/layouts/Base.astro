---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'TIPLA – die Planungssoftware für Tischlereien. Aus der Praxis, für die Praxis.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --holz-dunkel: #2b2118;
    --holz-hell: #e8d5b5;
    --papier: #faf7f2;
    --text: #1f1a15;
    --text-leise: #6b5f52;
    --akzent: #b5652b;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--papier);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
</style>
